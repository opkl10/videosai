#. Plugin Name of the plugin
#. Author of the plugin
#: statista-charts.php
msgid "Statista Charts"
msgstr "סטטיסטה גרפים"

#. Plugin URI of the plugin
#: statista-charts.php
msgid "https://example.com/statista-charts"
msgstr ""

#. Description of the plugin
#: statista-charts.php
msgid ""
"Beautiful, responsive statistics and charts inside posts — a Gutenberg block "
"plus a matching [statista_chart] shortcode."
msgstr ""
"סטטיסטיקות וגרפים נקיים ורספונסיביים בתוך הפוסטים — בלוק לגוטנברג ולצידו "
"שורטקוד [statista_chart]."

#: includes/class-block.php:77
msgid ""
"Statista Charts: the build directory is missing. Run \"npm install && npm "
"run build\" inside the plugin folder."
msgstr ""
"סטטיסטה גרפים: תיקיית ה-build חסרה. הריצו \"npm install && npm run build\" "
"בתיקיית התוסף."

