msgid "Bot token"
msgstr "אסימון הבוט"

#: social-hub/includes/admin/class-settings-page.php:324
msgid "Create a bot with @BotFather and paste the token it gives you."
msgstr "צרו בוט דרך @BotFather והדביקו את האסימון שהוא נותן לכם."

#: social-hub/includes/admin/class-settings-page.php:329
msgid "Channel or chat ID"
