msgstr "סטטוס"

#: social-hub/includes/admin/class-settings-page.php:225
msgid "Share new posts to this Facebook Page"
msgstr "לשתף פוסטים חדשים לעמוד הפייסבוק הזה"

#: social-hub/includes/admin/class-settings-page.php:231
msgid "Page ID"
msgstr "מזהה עמוד (Page ID)"

#: social-hub/includes/admin/class-settings-page.php:242
msgid "Facebook Page settings → About → Page ID. A numeric ID works best."
msgstr "הגדרות עמוד הפייסבוק ← אודות ← מזהה עמוד. עדיף מזהה מספרי."

#: social-hub/includes/admin/class-settings-page.php:247
msgid "Page access token"
msgstr "אסימון גישה לעמוד (Page access token)"

#: social-hub/includes/admin/class-settings-page.php:251
msgid "Use a long-lived Page access token with the pages_manage_posts permission. It is stored in your database, so treat it like a password."
msgstr "השתמשו באסימון גישה ארוך-טווח לעמוד עם ההרשאה pages_manage_posts. הוא נשמר במסד הנתונים שלכם, אז התייחסו אליו כמו לסיסמה."

#: social-hub/includes/admin/class-settings-page.php:256
msgid "Post format"
msgstr "סוג הפוסט"

#: social-hub/includes/admin/class-settings-page.php:261
msgid "Link post (Facebook builds the preview)"
msgstr "פוסט קישור (פייסבוק בונה את התצוגה המקדימה)"

