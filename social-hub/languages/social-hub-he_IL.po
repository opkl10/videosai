#: social-hub/includes/admin/class-settings-page.php:341
msgid "Use @channelname for a public channel, or the numeric ID for a private one. The bot must be an administrator there."
msgstr "השתמשו ב-@channelname לערוץ ציבורי, או במזהה המספרי לערוץ פרטי. הבוט חייב להיות מנהל שם."

