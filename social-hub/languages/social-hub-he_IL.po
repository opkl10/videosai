msgid "Add a Telegram bot token first."
msgstr "הוסיפו קודם אסימון בוט טלגרם."

#: social-hub/includes/providers/class-telegram.php:126
msgid "unknown bot"
msgstr "בוט לא ידוע"

#: social-hub/includes/providers/class-telegram.php:155
msgid "%1$s posting to %2$s"
msgstr "%1$s מפרסם אל %2$s"
