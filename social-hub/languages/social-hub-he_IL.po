#: social-hub/includes/admin/class-settings-page.php:110
msgid "Share buttons"
msgstr "כפתורי שיתוף"

#: social-hub/includes/admin/class-settings-page.php:111
msgid "Link previews"
msgstr "תצוגת קישורים"

#: social-hub/includes/admin/class-settings-page.php:112
msgid "Promotion"
msgstr "קידום"

#: social-hub/includes/admin/class-settings-page.php:113
msgid "Tips"
msgstr "טיפים"

#: social-hub/includes/admin/class-settings-page.php:114
msgid "Activity log"
msgstr "יומן פעילות"

#: social-hub/includes/admin/class-settings-page.php:129
msgid "Connected and sharing"
msgstr "מחובר ומשתף"

#: social-hub/includes/admin/class-settings-page.php:132
msgid "Configured but switched off"
msgstr "מוגדר אך כבוי"

#: social-hub/includes/admin/class-settings-page.php:135
msgid "Not connected"
msgstr "לא מחובר"

#: social-hub/includes/admin/class-settings-page.php:158
msgid "Automatic sharing"
msgstr "שיתוף אוטומטי"

#: social-hub/includes/admin/class-settings-page.php:161
msgid "Share a post to the connected networks when it is published"
msgstr "לשתף פוסט לרשתות המחוברות ברגע שהוא מתפרסם"

#: social-hub/includes/admin/class-settings-page.php:163
msgid "Only the first transition to \"published\" triggers a share, so editing an old post will not repost it."
msgstr "רק המעבר הראשון למצב \"פורסם\" מפעיל שיתוף, כך שעריכה של פוסט ישן לא תפרסם אותו מחדש."

#: social-hub/includes/admin/class-settings-page.php:167
msgid "Post types"
msgstr "סוגי תוכן"

#: social-hub/includes/admin/class-settings-page.php:172
msgid "Delay before sharing"
msgstr "השהיה לפני השיתוף"

#: social-hub/includes/admin/class-settings-page.php:185
msgid "seconds"
msgstr "שניות"

#: social-hub/includes/admin/class-settings-page.php:186
msgid "A short delay gives you time to fix a typo, and lets caches warm up before the link preview is fetched."
msgstr "השהיה קצרה נותנת לכם זמן לתקן שגיאת כתיב, ומאפשרת למטמון להתעדכן לפני שהרשת שולפת את התצוגה המקדימה."

#: social-hub/includes/admin/class-settings-page.php:191
msgid "Message template"
msgstr "תבנית ההודעה"

#: social-hub/includes/admin/class-settings-page.php:201
msgid "Available placeholders:"
msgstr "משתנים זמינים:"

#: social-hub/includes/admin/class-settings-page.php:208
msgid "Uninstall"
msgstr "הסרה"

#: social-hub/includes/admin/class-settings-page.php:214
msgid "Delete all Social Hub settings and logs when the plugin is deleted"
msgstr "למחוק את כל ההגדרות והיומנים של Social Hub בעת מחיקת התוסף"

#: social-hub/includes/admin/class-settings-page.php:232 social-hub/includes/admin/class-settings-page.php:323 social-hub/includes/admin/class-settings-page.php:388
msgid "Status"
msgstr "סטטוס"

#: social-hub/includes/admin/class-settings-page.php:235
msgid "Share new posts to this Facebook Page"
msgstr "לשתף פוסטים חדשים לעמוד הפייסבוק הזה"

#: social-hub/includes/admin/class-settings-page.php:241
msgid "Page ID"
msgstr "מזהה עמוד (Page ID)"

#: social-hub/includes/admin/class-settings-page.php:253
msgid "Facebook Page settings → About → Page ID. A numeric ID works best."
msgstr "הגדרות עמוד הפייסבוק ← אודות ← מזהה עמוד. עדיף מזהה מספרי."

#: social-hub/includes/admin/class-settings-page.php:258
msgid "Page access token"
msgstr "אסימון גישה לעמוד (Page access token)"

#: social-hub/includes/admin/class-settings-page.php:262
msgid "Use a long-lived Page access token with the pages_manage_posts permission. It is stored in your database, so treat it like a password."
msgstr "השתמשו באסימון גישה ארוך-טווח לעמוד עם ההרשאה pages_manage_posts. הוא נשמר במסד הנתונים שלכם, אז התייחסו אליו כמו לסיסמה."

#: social-hub/includes/admin/class-settings-page.php:267
msgid "Post format"
msgstr "סוג הפוסט"

#: social-hub/includes/admin/class-settings-page.php:272
msgid "Link post (Facebook builds the preview)"
msgstr "פוסט קישור (פייסבוק בונה את התצוגה המקדימה)"

#: social-hub/includes/admin/class-settings-page.php:275
msgid "Photo post using the featured image"
msgstr "פוסט תמונה עם התמונה הראשית"

#: social-hub/includes/admin/class-settings-page.php:282
msgid "Graph API version"
msgstr "גרסת Graph API"

#: social-hub/includes/admin/class-settings-page.php:293
msgid "Meta retires each version after about two years. Bump this when you migrate."
msgstr "מטא מוציאה כל גרסה משימוש אחרי כשנתיים. עדכנו את השדה הזה כשאתם עוברים גרסה."

#: social-hub/includes/admin/class-settings-page.php:297 social-hub/includes/admin/class-settings-page.php:370
msgid "Connection"
msgstr "חיבור"

#: social-hub/includes/admin/class-settings-page.php:303
msgid "Getting a Page access token"
msgstr "איך משיגים אסימון גישה לעמוד"

#: social-hub/includes/admin/class-settings-page.php:305
msgid "Create an app at developers.facebook.com and add the \"Facebook Login\" product."
msgstr "צרו אפליקציה ב-developers.facebook.com והוסיפו את המוצר \"Facebook Login\"."

#: social-hub/includes/admin/class-settings-page.php:306
msgid "Open the Graph API Explorer, pick your app, and request the pages_manage_posts, pages_read_engagement and pages_show_list permissions."
msgstr "פתחו את Graph API Explorer, בחרו את האפליקציה שלכם ובקשו את ההרשאות pages_manage_posts, pages_read_engagement ו-pages_show_list."

#: social-hub/includes/admin/class-settings-page.php:307
msgid "Select your Page in the token dropdown to swap the user token for a Page token."
msgstr "בחרו את העמוד שלכם בתפריט האסימונים כדי להחליף את אסימון המשתמש באסימון עמוד."

#: social-hub/includes/admin/class-settings-page.php:308
msgid "Exchange it for a long-lived token in the Access Token Debugger, then paste it above."
msgstr "המירו אותו לאסימון ארוך-טווח ב-Access Token Debugger, והדביקו אותו למעלה."

#: social-hub/includes/admin/class-settings-page.php:326
msgid "Share new posts to this Telegram chat"
msgstr "לשתף פוסטים חדשים לצ׳אט הטלגרם הזה"

#: social-hub/includes/admin/class-settings-page.php:332
msgid "Bot token"
msgstr "אסימון הבוט"

#: social-hub/includes/admin/class-settings-page.php:336
msgid "Create a bot with @BotFather and paste the token it gives you."
msgstr "צרו בוט דרך @BotFather והדביקו את האסימון שהוא נותן לכם."

#: social-hub/includes/admin/class-settings-page.php:341
msgid "Channel or chat ID"
msgstr "מזהה ערוץ או צ׳אט"

#: social-hub/includes/admin/class-settings-page.php:354
msgid "Use @channelname for a public channel, or the numeric ID for a private one. The bot must be an administrator there."
msgstr "השתמשו ב-@channelname לערוץ ציבורי, או במזהה המספרי לערוץ פרטי. הבוט חייב להיות מנהל שם."

#: social-hub/includes/admin/class-settings-page.php:358
msgid "Link preview"
msgstr "תצוגה מקדימה של קישור"

#: social-hub/includes/admin/class-settings-page.php:364
msgid "Send messages without the link preview card"
msgstr "לשלוח הודעות בלי כרטיס תצוגה מקדימה"

#: social-hub/includes/admin/class-settings-page.php:391
msgid "Show share buttons for readers"
msgstr "להציג כפתורי שיתוף לקוראים"

#: social-hub/includes/admin/class-settings-page.php:396
msgid "Networks"
msgstr "רשתות"

#: social-hub/includes/admin/class-settings-page.php:416
msgid "Position"
msgstr "מיקום"

#: social-hub/includes/admin/class-settings-page.php:420
msgid "After the content"
msgstr "אחרי התוכן"

#: social-hub/includes/admin/class-settings-page.php:421
msgid "Before the content"
msgstr "לפני התוכן"

#: social-hub/includes/admin/class-settings-page.php:422
msgid "Before and after"
msgstr "לפני ואחרי"

#: social-hub/includes/admin/class-settings-page.php:423
msgid "Only where I place them"
msgstr "רק במקום שאני אבחר"

#: social-hub/includes/admin/class-settings-page.php:426
msgid "Place them yourself with the shortcode"
msgstr "אפשר למקם בעצמכם עם השורטקוד"

#: social-hub/includes/admin/class-settings-page.php:428
msgid "or in a template with"
msgstr "או בקובץ תבנית עם"

#: social-hub/includes/admin/class-settings-page.php:434
msgid "Show on"
msgstr "להציג ב"

#: social-hub/includes/admin/class-settings-page.php:439
msgid "Heading"
msgstr "כותרת"

#: social-hub/includes/admin/class-settings-page.php:448 social-hub/includes/class-share-buttons.php:240
msgid "Share this post"
msgstr "שתפו את הפוסט"

#: social-hub/includes/admin/class-settings-page.php:453
msgid "Appearance"
msgstr "עיצוב"

#: social-hub/includes/admin/class-settings-page.php:456
msgid "Filled"
msgstr "מלא"

#: social-hub/includes/admin/class-settings-page.php:457
msgid "Outline"
msgstr "מתאר"

#: social-hub/includes/admin/class-settings-page.php:461
msgid "Show network names next to the icons"
msgstr "להציג את שמות הרשתות ליד האייקונים"

#: social-hub/includes/admin/class-settings-page.php:481
msgid "An SEO plugin that already outputs Open Graph tags was detected. Social Hub stays out of its way unless you turn the option below off."
msgstr "זוהה תוסף SEO שכבר מוסיף תגיות Open Graph. ‏Social Hub לא יתערב, אלא אם תכבו את האפשרות שלמטה."

#: social-hub/includes/admin/class-settings-page.php:487
msgid "Open Graph tags"
msgstr "תגיות Open Graph"

#: social-hub/includes/admin/class-settings-page.php:490
msgid "Add Open Graph and Twitter card tags to the page head"
msgstr "להוסיף תגיות Open Graph ו-Twitter card ל-head של העמוד"

#: social-hub/includes/admin/class-settings-page.php:492
msgid "Skip them when an SEO plugin already handles previews"
msgstr "לדלג עליהן כשתוסף SEO כבר מטפל בתצוגות המקדימות"

#: social-hub/includes/admin/class-settings-page.php:498
msgid "Fallback image"
msgstr "תמונת ברירת מחדל"

#: social-hub/includes/admin/class-settings-page.php:513
msgid "Choose image"
msgstr "בחירת תמונה"

#: social-hub/includes/admin/class-settings-page.php:514
msgid "Remove"
msgstr "הסרה"

#: social-hub/includes/admin/class-settings-page.php:517
msgid "Used when a post has no featured image. 1200×630 pixels works well everywhere."
msgstr "בשימוש כשלפוסט אין תמונה ראשית. מידות 1200×630 פיקסלים עובדות טוב בכל מקום."

#: social-hub/includes/admin/class-settings-page.php:522
msgid "Facebook App ID"
msgstr "מזהה אפליקציית פייסבוק"

#: social-hub/includes/admin/class-settings-page.php:533
msgid "Optional. Adds the fb:app_id tag so your Page shows up in Meta insights."
msgstr "אופציונלי. מוסיף את התגית fb:app_id כדי שהעמוד שלכם יופיע בנתוני מטא."

#: social-hub/includes/admin/class-settings-page.php:538
msgid "X / Twitter handle"
msgstr "שם המשתמש ב-X / טוויטר"

#: social-hub/includes/admin/class-settings-page.php:553
msgid "Card size"
msgstr "גודל הכרטיס"

#: social-hub/includes/admin/class-settings-page.php:557
msgid "Large image"
msgstr "תמונה גדולה"

#: social-hub/includes/admin/class-settings-page.php:560
msgid "Small thumbnail"
msgstr "תמונה ממוזערת"

#: social-hub/includes/admin/class-settings-page.php:579
msgid "How ready is this site?"
msgstr "כמה האתר מוכן?"

#: social-hub/includes/admin/class-settings-page.php:584
msgid "%1$d of %2$d checks passed."
msgstr "%1$d מתוך %2$d בדיקות עברו."

#: social-hub/includes/admin/class-settings-page.php:592
msgid "Sharing window"
msgstr "חלון שעות לשיתוף"

#: social-hub/includes/admin/class-settings-page.php:595
msgid "Hold shares"
msgstr "החזקת שיתופים"

#: social-hub/includes/admin/class-settings-page.php:601
msgid "Only publish to the networks inside the hours below"
msgstr "לפרסם לרשתות רק בתוך השעות שלמטה"

#: social-hub/includes/admin/class-settings-page.php:604
msgid "A post published outside the window waits for the next opening instead of going out to an empty feed."
msgstr "פוסט שמתפרסם מחוץ לחלון ימתין לפתיחה הבאה, במקום לצאת לפיד ריק."

#: social-hub/includes/admin/class-settings-page.php:608
msgid "Hours"
msgstr "שעות"

#: social-hub/includes/admin/class-settings-page.php:611
msgid "From"
msgstr "משעה"

#: social-hub/includes/admin/class-settings-page.php:619
msgid "until"
msgstr "עד שעה"

#: social-hub/includes/admin/class-settings-page.php:630
msgid "Site time zone: %s."
msgstr "אזור הזמן של האתר: %s."

#: social-hub/includes/admin/class-settings-page.php:638
msgid "Days to skip"
msgstr "ימים לדלג עליהם"

#: social-hub/includes/admin/class-settings-page.php:653
msgid "Shares that fall on a skipped day move to the next day inside the window."
msgstr "שיתוף שנופל ביום שדילגתם עליו יעבור ליום הבא בתוך החלון."

#: social-hub/includes/admin/class-settings-page.php:658
msgid "Link tracking"
msgstr "מדידת קישורים"

#: social-hub/includes/admin/class-settings-page.php:661
msgid "UTM parameters"
msgstr "פרמטרי UTM"

#: social-hub/includes/admin/class-settings-page.php:664
msgid "Tag links published by Social Hub"
msgstr "לתייג קישורים ש-Social Hub מפרסם"

#: social-hub/includes/admin/class-settings-page.php:666
msgid "Tag links shared by readers through the share buttons"
msgstr "לתייג קישורים שקוראים משתפים דרך כפתורי השיתוף"

#: social-hub/includes/admin/class-settings-page.php:669
msgid "Without tags, analytics lumps every social visit together and you cannot tell which network is worth your time."
msgstr "בלי תיוג, מערכות הניתוח מאחדות את כל הכניסות מהסושיאל ואי אפשר לדעת איזו רשת באמת שווה את הזמן שלכם."

#: social-hub/includes/admin/class-settings-page.php:674
msgid "utm_medium"
msgstr "utm_medium"

#: social-hub/includes/admin/class-settings-page.php:689
msgid "utm_campaign"
msgstr "utm_campaign"

#: social-hub/includes/admin/class-settings-page.php:701
msgid "Placeholders:"
msgstr "משתנים:"

#: social-hub/includes/admin/class-settings-page.php:721
msgid "Before you publish"
msgstr "לפני שמפרסמים"

#: social-hub/includes/admin/class-settings-page.php:723
msgid "Give every post a 1200×630 image. In a feed the image is the advertisement and the text is the footnote — a bare link takes a fraction of the space and gets a fraction of the clicks."
msgstr "תנו לכל פוסט תמונה במידות 1200×630. בפיד התמונה היא הפרסומת והטקסט הוא הערת השוליים — קישור בלי תמונה תופס שבריר מהשטח ומקבל שבריר מההקלקות."

#: social-hub/includes/admin/class-settings-page.php:724
msgid "Keep the headline under about 70 characters so a phone shows all of it instead of cutting it mid-sentence."
msgstr "שמרו על כותרת של עד כ-70 תווים, כדי שבמובייל היא תוצג במלואה ולא תיחתך באמצע המשפט."

#: social-hub/includes/admin/class-settings-page.php:725
msgid "Write the excerpt yourself. It becomes the description under the link, and the opening sentence of an article is rarely its best pitch."
msgstr "כתבו את התקציר בעצמכם. הוא זה שמופיע מתחת לקישור, והמשפט הראשון של הכתבה כמעט אף פעם לא הנימוק הכי טוב להיכנס אליה."

#: social-hub/includes/admin/class-settings-page.php:726
msgid "Do not paste the title twice. The share text should be the one sentence that makes somebody stop scrolling — the surprising number, the mistake you made, the thing they can use today."
msgstr "אל תדביקו את הכותרת פעמיים. טקסט השיתוף הוא המשפט האחד שגורם למישהו לעצור את הגלילה — המספר המפתיע, הטעות שעשיתם, הדבר שאפשר ליישם כבר היום."

#: social-hub/includes/admin/class-settings-page.php:727
msgid "End with a question. Comments push a post to people who do not follow you, and the first hour of comments sets the reach for the rest of the day."
msgstr "סיימו בשאלה. תגובות דוחפות את הפוסט לאנשים שלא עוקבים אחריכם, והשעה הראשונה של התגובות קובעת את החשיפה של כל שאר היום."

#: social-hub/includes/admin/class-settings-page.php:731
msgid "Timing and frequency"
msgstr "תזמון ותדירות"

#: social-hub/includes/admin/class-settings-page.php:733
msgid "Publish when readers are awake. Weekday mornings around 08:00–10:00 and evenings around 19:00–22:00 work for most Hebrew-speaking audiences. The sharing window on the Promotion tab holds a 03:00 post until the morning."
msgstr "פרסמו כשהקוראים ערים. בימי חול בוקר סביב 08:00–10:00 וערב סביב 19:00–22:00 עובדים לרוב הקהלים דוברי העברית. חלון השעות בלשונית \"קידום\" ידחה פוסט של 03:00 עד הבוקר."

#: social-hub/includes/admin/class-settings-page.php:734
msgid "An Israeli week is not an American week. Friday afternoon and Saturday behave differently here, so check your own numbers before you copy a schedule from a blog post."
msgstr "שבוע ישראלי הוא לא שבוע אמריקאי. שישי אחר הצהריים ושבת מתנהגים כאן אחרת, אז תבדקו את המספרים שלכם לפני שאתם מעתיקים לוח זמנים מפוסט באנגלית."

#: social-hub/includes/admin/class-settings-page.php:735
msgid "Three good posts a week beat ten thin ones. Networks judge each post by its engagement, so a weak post quietly costs you reach on the next one."
msgstr "שלושה פוסטים טובים בשבוע עדיפים על עשרה חלשים. הרשתות מודדות כל פוסט לפי המעורבות שלו, כך שפוסט חלש גובה מכם חשיפה גם בפוסט הבא."

#: social-hub/includes/admin/class-settings-page.php:736
msgid "Reshare evergreen posts after two or three months with a new opening line. Almost nobody saw them the first time."
msgstr "שתפו מחדש תוכן ירוק-עד אחרי חודשיים-שלושה, עם משפט פתיחה חדש. כמעט אף אחד לא ראה אותו בפעם הראשונה."

#: social-hub/includes/admin/class-settings-page.php:740
msgid "Getting it in front of people"
msgstr "איך מגיעים לאנשים"

#: social-hub/includes/admin/class-settings-page.php:742
msgid "Answer every comment in the first hour. It is the cheapest reach you will ever buy."
msgstr "תענו לכל תגובה בשעה הראשונה. זו החשיפה הזולה ביותר שתקנו אי פעם."

#: social-hub/includes/admin/class-settings-page.php:743
msgid "Boost only what already works. Putting a small budget behind a post that is doing well organically beats guessing in advance which post deserves it."
msgstr "קדמו בתשלום רק מה שכבר עובד. תקציב קטן מאחורי פוסט שמצליח אורגנית שווה הרבה יותר מניחוש מראש איזה פוסט ראוי לתקציב."

#: social-hub/includes/admin/class-settings-page.php:744
msgid "In groups and communities, contribute to the discussion and let the link follow. Dropping links is how accounts get muted."
msgstr "בקבוצות ובקהילות — תרמו לדיון, והקישור יבוא אחר כך. זריקת קישורים היא הדרך הבטוחה להשתקה."

#: social-hub/includes/admin/class-settings-page.php:745
msgid "For Hebrew-speaking audiences, WhatsApp and Telegram often send more traffic than Facebook, because sharing there is one tap into a private conversation. Keep both buttons switched on."
msgstr "אצל קהל דובר עברית, וואטסאפ וטלגרם שולחים לא פעם יותר תנועה מפייסבוק, כי שיתוף שם הוא הקלקה אחת לתוך שיחה פרטית. השאירו את שני הכפתורים דלוקים."

#: social-hub/includes/admin/class-settings-page.php:746
msgid "Cut one post into several formats: a quote card, a short video, a carousel. Same idea, different surfaces, more chances to be seen."
msgstr "פרקו פוסט אחד לכמה פורמטים: כרטיס ציטוט, סרטון קצר, קרוסלה. אותו רעיון, משטחים שונים, יותר הזדמנויות להיראות."

#: social-hub/includes/admin/class-settings-page.php:750
msgid "Measuring"
msgstr "מדידה"

#: social-hub/includes/admin/class-settings-page.php:752
msgid "Tag every link with UTM parameters and judge a network by the sessions it sends, not by the likes it collects."
msgstr "תייגו כל קישור בפרמטרי UTM, ותשפטו רשת לפי הכניסות שהיא שולחת ולא לפי הלייקים שהיא אוספת."

#: social-hub/includes/admin/class-settings-page.php:753
msgid "Watch clicks and saves rather than reach. Reach is what the network decided to give you; a click is what your audience decided to give you."
msgstr "תסתכלו על הקלקות ושמירות ולא על חשיפה. חשיפה זה מה שהרשת החליטה לתת לכם; הקלקה זה מה שהקהל שלכם החליט לתת לכם."

#: social-hub/includes/admin/class-settings-page.php:754
msgid "Once a month, look at your three best posts and ask what they had in common. Then do that again on purpose."
msgstr "פעם בחודש תסתכלו על שלושת הפוסטים הכי מוצלחים ותשאלו מה משותף להם. ואז תעשו את זה שוב, בכוונה."

#: social-hub/includes/admin/class-settings-page.php:760
msgid "The short version of what tends to work. The Promotion tab turns most of it into settings, and the box in the post editor checks each post against it before it goes out."
msgstr "הגרסה הקצרה של מה שבדרך כלל עובד. לשונית \"קידום\" הופכת את רוב זה להגדרות, והתיבה בעורך הפוסטים בודקת כל פוסט מולן לפני שהוא יוצא."

#: social-hub/includes/admin/class-settings-page.php:804
msgid "The log was cleared."
msgstr "היומן נוקה."

#: social-hub/includes/admin/class-settings-page.php:810
msgid "When"
msgstr "מתי"

#: social-hub/includes/admin/class-settings-page.php:811
msgid "Network"
msgstr "רשת"

#: social-hub/includes/admin/class-settings-page.php:812
msgid "Post"
msgstr "פוסט"

#: social-hub/includes/admin/class-settings-page.php:813
msgid "Result"
msgstr "תוצאה"

#: social-hub/includes/admin/class-settings-page.php:818
msgid "Nothing has been shared yet."
msgstr "עדיין לא שותף דבר."

#: social-hub/includes/admin/class-settings-page.php:852
msgid "Clear log"
msgstr "ניקוי היומן"

#: social-hub/includes/admin/class-settings-page.php:946
msgid "Saved — leave blank to keep it"
msgstr "נשמר — השאירו ריק כדי לשמור עליו"

#: social-hub/includes/admin/class-settings-page.php:947
msgid "Paste the token here"
msgstr "הדביקו כאן את האסימון"

#: social-hub/includes/admin/class-settings-page.php:953
msgid "Delete the stored token"
msgstr "מחיקת האסימון השמור"

#: social-hub/includes/admin/class-settings-page.php:968
msgid "Test connection"
msgstr "בדיקת חיבור"

#: social-hub/includes/admin/class-settings-page.php:973
msgid "Save your changes first — the test uses the stored credentials."
msgstr "שמרו קודם את השינויים — הבדיקה משתמשת בפרטים השמורים."

#: social-hub/includes/class-advisor.php:83
msgid "Connected networks: %d"
msgstr "רשתות מחוברות: %d"

#: social-hub/includes/class-advisor.php:86
msgid "No network is connected"
msgstr "אף רשת לא מחוברת"

#: social-hub/includes/class-advisor.php:87
msgid "Nothing is published automatically until at least one network is connected and switched on."
msgstr "שום דבר לא מתפרסם אוטומטית עד שרשת אחת לפחות מחוברת ודלוקה."

#: social-hub/includes/class-advisor.php:94
msgid "Link previews are handled"
msgstr "יש טיפול בתצוגת הקישורים"

#: social-hub/includes/class-advisor.php:94
msgid "Nothing controls your link previews"
msgstr "אף אחד לא שולט בתצוגת הקישורים שלכם"

#: social-hub/includes/class-advisor.php:95
msgid "Without Open Graph tags the networks guess the title and image, and usually guess badly."
msgstr "בלי תגיות Open Graph הרשתות מנחשות את הכותרת והתמונה, ובדרך כלל מנחשות רע."

#: social-hub/includes/class-advisor.php:102
msgid "A fallback preview image is set"
msgstr "מוגדרת תמונת ברירת מחדל"

#: social-hub/includes/class-advisor.php:102
msgid "No fallback preview image"
msgstr "אין תמונת ברירת מחדל"

#: social-hub/includes/class-advisor.php:103
msgid "Posts without a featured image fall back to this one instead of sharing a bare link."
msgstr "פוסטים בלי תמונה ראשית יקבלו את התמונה הזו, במקום לצאת כקישור חשוף."

#: social-hub/includes/class-advisor.php:110
msgid "Readers can share your posts"
msgstr "הקוראים יכולים לשתף את הפוסטים"

#: social-hub/includes/class-advisor.php:110
msgid "Share buttons are switched off"
msgstr "כפתורי השיתוף כבויים"

#: social-hub/includes/class-advisor.php:111
msgid "A share from a reader reaches an audience your own page never touches."
msgstr "שיתוף של קורא מגיע לקהל שהעמוד שלכם לא נוגע בו לעולם."

#: social-hub/includes/class-advisor.php:118
msgid "Shared links are tagged for analytics"
msgstr "הקישורים מתויגים למדידה"

#: social-hub/includes/class-advisor.php:118
msgid "Shared links are not tagged"
msgstr "הקישורים לא מתויגים"

#: social-hub/includes/class-advisor.php:119
msgid "UTM tags are the only way to see which network actually sends you readers, rather than guessing from likes."
msgstr "תיוג UTM הוא הדרך היחידה לראות איזו רשת באמת שולחת לכם קוראים, במקום לנחש לפי לייקים."

#: social-hub/includes/class-advisor.php:126
msgid "Readable permalinks"
msgstr "קישורים קריאים"

#: social-hub/includes/class-advisor.php:126
msgid "Permalinks look like ?p=123"
msgstr "הקישורים נראים כמו ‎?p=123"

#: social-hub/includes/class-advisor.php:127
msgid "A readable URL gets clicked more often, and survives being pasted into a chat."
msgstr "כתובת קריאה מקבלת יותר הקלקות, ושורדת הדבקה בצ׳אט."

#: social-hub/includes/class-advisor.php:134
msgid "Shares wait for your best hours"
msgstr "השיתופים ממתינים לשעות הטובות"

#: social-hub/includes/class-advisor.php:134
msgid "Shares go out the moment you publish"
msgstr "השיתופים יוצאים ברגע הפרסום"

#: social-hub/includes/class-advisor.php:135
msgid "A post published at 03:00 burns its first hour of reach while everyone sleeps."
msgstr "פוסט שמתפרסם ב-03:00 שורף את שעת החשיפה הראשונה שלו בזמן שכולם ישנים."

#: social-hub/includes/class-advisor.php:178
msgid "Using the fallback image"
msgstr "משתמש בתמונת ברירת המחדל"

#: social-hub/includes/class-advisor.php:178
msgid "No featured image"
msgstr "אין תמונה ראשית"

#: social-hub/includes/class-advisor.php:181
msgid "A post with a %1$d×%2$d image takes several times more space in the feed than a bare link."
msgstr "פוסט עם תמונה %1$d×%2$d תופס בפיד פי כמה שטח מקישור חשוף."

#: social-hub/includes/class-advisor.php:198
msgid "Featured image is %1$d×%2$d"
msgstr "התמונה הראשית היא %1$d×%2$d"

#: social-hub/includes/class-advisor.php:204
msgid "Below %1$d×%2$d the networks upscale the image and it looks soft."
msgstr "מתחת ל-%1$d×%2$d הרשתות מותחות את התמונה והיא נראית מטושטשת."

#: social-hub/includes/class-advisor.php:214
msgid "Featured image is large enough"
msgstr "התמונה הראשית גדולה מספיק"

#: social-hub/includes/class-advisor.php:234
msgid "Title is %d characters"
msgstr "הכותרת באורך %d תווים"

#: social-hub/includes/class-advisor.php:239
msgid "Preview cards cut the title around %d characters on a phone."
msgstr "כרטיס התצוגה חותך את הכותרת סביב %d תווים במובייל."

#: social-hub/includes/class-advisor.php:245
msgid "Title fits a preview card"
msgstr "הכותרת נכנסת בכרטיס התצוגה"

#: social-hub/includes/class-advisor.php:259
msgid "No manual excerpt"
msgstr "אין תקציר ידני"

#: social-hub/includes/class-advisor.php:260
msgid "The excerpt is the description under the link. Writing it yourself beats the first sentence of the post."
msgstr "התקציר הוא התיאור שמתחת לקישור. עדיף שתכתבו אותו בעצמכם מאשר שייקח את המשפט הראשון של הפוסט."

#: social-hub/includes/class-advisor.php:264
msgid "Excerpt written by hand"
msgstr "התקציר נכתב ידנית"

#: social-hub/includes/class-advisor.php:282
msgid "Share text is %d characters"
msgstr "טקסט השיתוף באורך %d תווים"

#: social-hub/includes/class-advisor.php:287
msgid "Feeds fold anything past roughly %d characters behind a \"see more\" link."
msgstr "הפיד מקפל כל מה שמעבר לכ-%d תווים מאחורי \"ראה עוד\"."

#: social-hub/includes/class-advisor.php:293
msgid "Share text stays above the fold"
msgstr "טקסט השיתוף נשאר גלוי"

#: social-hub/includes/class-advisor.php:310
msgid "No tags"
msgstr "אין תגיות"

#: social-hub/includes/class-advisor.php:311
msgid "Two or three tags become hashtags in the share text, and give people a reason to find the post later."
msgstr "שתיים-שלוש תגיות הופכות להאשטגים בטקסט השיתוף, ונותנות לאנשים דרך למצוא את הפוסט אחר כך."

#: social-hub/includes/class-advisor.php:321
msgid "%d tags"
msgstr "%d תגיות"

#: social-hub/includes/class-advisor.php:324
msgid "Only the first six become hashtags. A wall of them reads as spam anyway."
msgstr "רק שש הראשונות הופכות להאשטגים. קיר של האשטגים נקרא ממילא כספאם."

#: social-hub/includes/class-advisor.php:328
msgid "Tags will become hashtags"
msgstr "התגיות יהפכו להאשטגים"

#: social-hub/includes/class-advisor.php:345
msgid "The share text asks nothing"
msgstr "טקסט השיתוף לא שואל כלום"

#: social-hub/includes/class-advisor.php:346
msgid "A question at the end earns comments, and comments are what push a post to people who do not follow you."
msgstr "שאלה בסוף מייצרת תגובות, ותגובות הן מה שדוחף את הפוסט לאנשים שלא עוקבים אחריכם."

#: social-hub/includes/class-advisor.php:350
msgid "The share text invites a reply"
msgstr "טקסט השיתוף מזמין תגובה"

#: social-hub/includes/class-publisher.php:157
msgid "Shared to %s."
msgstr "שותף אל %s."

#: social-hub/includes/class-settings.php:380
msgid "The sharing window must end after it starts, so it was reset to 09:00–21:00."
msgstr "חלון השעות חייב להסתיים אחרי שהוא מתחיל, ולכן הוא אופס ל-09:00–21:00."

