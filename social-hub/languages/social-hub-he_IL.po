msgstr "%1$s: %2$s"

#: social-hub/includes/admin/class-settings-page.php:34
msgid "You are not allowed to access this page."
msgstr "אין לכם הרשאה לגשת לעמוד הזה."

#: social-hub/includes/admin/class-settings-page.php:44
msgid "Publish new posts to your social pages automatically, add share buttons for your readers, and make sure shared links show the right title and image."
msgstr "פרסמו פוסטים חדשים לעמודי הסושיאל שלכם באופן אוטומטי, הוסיפו כפתורי שיתוף לקוראים, וודאו שקישורים משותפים מציגים את הכותרת והתמונה הנכונות."

#: social-hub/includes/admin/class-settings-page.php:107
msgid "General"
msgstr "כללי"

#: social-hub/includes/admin/class-settings-page.php:108 social-hub/includes/class-share-buttons.php:40
msgid "Facebook"
msgstr "פייסבוק"

