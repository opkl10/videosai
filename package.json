{
  "name": "videosai",
  "version": "0.1.0",
  "private": true,
  "description": "VideosAI - a starter full-stack app that generates AI-style summaries and tags for videos (runs fully offline).",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev:agent": "node examples/custom-agent/agent.mjs",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
